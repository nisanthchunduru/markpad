{
  "name": "markpad",
  "displayName": "Markpad: Typora-inspired Markdown Editor",
  "description": "A Typora-inspired, live-preview Markdown editor inside VS Code.",
  "version": "0.1.54",
  "publisher": "nisanthchunduru",
  "repository": "https://github.com/nisanthchunduru/markpad.git",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Editors"
  ],
  "main": "./build/extension.js",
  "activationEvents": [
    "onCustomEditor:markpad.editor"
  ],
  "contributes": {
    "configuration": {
      "title": "Markpad",
      "properties": {
        "markpad.theme": {
          "type": "string",
          "enum": [
            "github",
            "gothic",
            "newsprint",
            "night",
            "pixyll",
            "pixyll-night",
            "whitey"
          ],
          "default": "github",
          "description": "Writing theme used by Markpad Markdown editors."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "markpad.editor",
        "displayName": "Markpad",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.mdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "markpad.open",
        "title": "Open in Markpad",
        "category": "Markdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markpad.open",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run check && npm run build && node --test test/*.test.mjs",
    "test:editing": "npm run build && node scripts/test-editing.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.1",
    "@types/vscode": "1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  }
}
